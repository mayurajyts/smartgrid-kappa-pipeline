# =============================================================================
# EC8202 Smart Grid Kappa Pipeline — environment configuration
# -----------------------------------------------------------------------------
# This file is the SINGLE source of every tunable in the system. Nothing in the
# codebase hardcodes a host, port, threshold or path; everything is read through
# common/config.py. That is what makes the stack reproducible from a clean clone
# and what lets the *same* code run live and in replay with different settings.
#
# Copy to .env (`make up` does this automatically if .env is missing).
# Credentials here are development-only. Production secret handling is discussed
# in the report's "Production-scale changes" section.
# =============================================================================

# ----------------------------------------------------------------------------
# Simulated clock (docs/IMPLEMENTATION_PLAN.md §0, §14)
# 1 simulated day = 5 real minutes = 300 real seconds.
# Every service prints this ratio at startup.
# ----------------------------------------------------------------------------
# SIM_START_DATE is the simulated date the demo begins on (plan §14).
SIM_START_DATE=2026-01-01
SIM_DAY_REAL_SECONDS=300

# SIM_ANCHOR_REAL is the REAL instant at which SIM_START_DATE began — normally
# the moment the stack started. `make up` stamps it automatically; leave it
# blank and each process falls back to its own start time.
#
# These are two SEPARATE anchors on purpose. Using the simulated start date as
# the real anchor too would multiply all elapsed real time since 2026-01-01 by
# 288, so the clock would read a date centuries in the future.
SIM_ANCHOR_REAL=

# ----------------------------------------------------------------------------
# Kafka — the Kappa log. Single broker, KRaft mode (no ZooKeeper).
# INTERNAL is used by containers on the compose network; EXTERNAL by tools on
# the host. Two listeners are required because the advertised hostname differs.
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_HOST_PORT=29092

# Topic names (§6 data contracts). Changeable in one place.
TOPIC_METER_READINGS=meter.readings.v1
TOPIC_METER_READINGS_CLEAN=meter.readings.clean.v1
TOPIC_METER_READINGS_DLQ=meter.readings.dlq.v1
TOPIC_TARIFF_REFERENCE=tariff.reference.v1
TOPIC_WEATHER_FORECAST=weather.forecast.v1

# Partitioning: 6 partitions on the telemetry topic keyed by grid_zone gives
# per-zone ordering, which the windowed zone aggregates depend on (§3).
TOPIC_METER_PARTITIONS=6
TOPIC_REFERENCE_PARTITIONS=1
TOPIC_REPLICATION_FACTOR=1

# Retention must cover the FULL simulated history — replay is the architecture,
# not a recovery feature. 7 days of wall-clock retention covers far more
# simulated history than this project will ever generate.
TOPIC_METER_RETENTION_MS=604800000

# ----------------------------------------------------------------------------
# PostgreSQL — serving store + Airflow metadata, isolated by database.
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Serving database (zone aggregates, bills, alerts, audit)
POSTGRES_DB=smartgrid
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=smartgrid

# Airflow metadata database — same instance, separate database and role
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow

# ----------------------------------------------------------------------------
# Object store — S3-compatible, holds the curated Parquet archive (§3).
# The plan names MinIO; MinIO's images now require registry authentication,
# which would break reproducibility from a clean clone, so an S3-compatible
# substitute is used. See docs/ADR-003-object-store.md. The variables are named
# for the S3 API rather than the vendor, because the API is what the
# architecture depends on.
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://objectstore:8333
S3_EXTERNAL_ENDPOINT=http://localhost:8333
S3_API_HOST_PORT=8333
S3_CONSOLE_HOST_PORT=8888
S3_CURATED_BUCKET=smartgrid-curated

# ----------------------------------------------------------------------------
# Logging (§8) — structlog JSON to stdout, mandatory fields bound per service.
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Metrics (§8) — each service exposes a Prometheus scrape endpoint.
# ----------------------------------------------------------------------------
METRICS_PORT=8000

# =============================================================================
# PHASE 1 - data sources
# =============================================================================

# ----------------------------------------------------------------------------
# Meter simulator
# ----------------------------------------------------------------------------
# Real seconds between ticks. Each tick emits one reading per meter.
# 2s x 288 compression = one reading per ~9.6 simulated minutes, i.e. ~150
# readings per meter per simulated day - enough to shape a recognisable daily
# curve without flooding a single broker.
METER_TICK_REAL_SECONDS=2.0

# 0 = every household in simulators/reference/households.csv (200).
# Set lower to lighten the demo on a constrained machine.
METER_LIMIT=0

# Clear-sky assumption used by the producer (0-1). The producer deliberately does
# NOT consume the weather topic: a source that read back from its own downstream
# could not be replayed independently. The forecast is applied downstream instead.
DEFAULT_SOLAR_INDEX=0.85

# ----------------------------------------------------------------------------
# Fault injection - the test fixtures for Job A DLQ and Job D alerts.
#
# These are NOT decoration. Job A validation, DLQ routing and deduplication can
# only be demonstrated if something produces violating records, and the
# correlation-id trace demo (section 11 step 7) needs a rejected record to exist.
# Defaults are small but non-zero so the DLQ always has content at demo time.
#
# The four REJECTION rates must sum to well under 0.02: the Airflow data-quality
# gate fails the daily report above a 2% reject rate (section 7), so larger
# values would make the pipeline fail its own gate by design.
# ----------------------------------------------------------------------------
FAULT_INJECTION_ENABLED=true

# --- Faults Job A must REJECT to the DLQ (sum = 0.008) ---
# Nulls a required field -> DLQ reason null_required_field
FAULT_RATE_NULL_FIELD=0.002
# Negates consumption -> DLQ reason negative_kwh
FAULT_RATE_NEGATIVE_KWH=0.002
# Solar above the physical panel cap -> DLQ reason solar_above_capacity
FAULT_RATE_SOLAR_SPIKE=0.002
# Event timestamp in the future -> DLQ reason timestamp_in_future
FAULT_RATE_FUTURE_TIMESTAMP=0.002
FAULT_FUTURE_TIMESTAMP_SIM_MINUTES=30

# --- Faults producing VALID records that stress stateful processing ---
# Higher rates: these are deduplicated or watermarked rather than rejected, so
# they do not count against the data-quality gate.
# Same event_id republished -> exercises dropDuplicates
FAULT_RATE_DUPLICATE=0.01
# Back-dated event -> exercises the watermark
FAULT_RATE_LATE_EVENT=0.01
# MUST exceed the 2-minute watermark in Job A, or the event is merely
# out-of-order (handled correctly) rather than genuinely late.
FAULT_LATE_EVENT_SIM_MINUTES=4

# --- Meter dropout: the meter emits NOTHING for a while ---
# Unlike the others this removes a record rather than corrupting one, which is
# what drives the METER_SILENT alert and the NoDataReceived Prometheus rule.
# In REAL seconds, because the alert rules are written against real time.
FAULT_RATE_METER_DROPOUT=0.001
FAULT_METER_DROPOUT_REAL_SECONDS=90

# ----------------------------------------------------------------------------
# Tariff / weather simulator - the daily file feed
# ----------------------------------------------------------------------------
DROP_DIR=/data/drop

# Share of households receiving a subsidy. Must be non-zero or the subsidy
# branch of the billing maths is never exercised by the demo.
SUBSIDY_SHARE=0.25

# Probability a zone gets a heavily-clouded simulated day. This is the lever the
# section 11 step 4 demo pulls: an overcast day suppresses solar generation and
# makes the LOW_RENEWABLE alert fire.
OVERCAST_DAY_PROBABILITY=0.25

# false honours assumption section 14: day D tariff is delivered at the START of
# day D+1, so the first simulated day has no tariff and Job C must write the
# running kWh with tariff_rate = NULL rather than guessing. Set true only to skip
# the initial 5-minute wait when rehearsing.
SEED_PREVIOUS_DAY_ON_STARTUP=false

# ----------------------------------------------------------------------------
# Batch loader - drop directory to compacted Kafka topics
# ----------------------------------------------------------------------------
PROCESSED_MARKER_DIR=/data/drop/.processed

# Polls rather than using inotify: filesystem events are unreliable for
# bind-mounted volumes under Docker Desktop for Windows, and a loader that
# silently never sees a file would break the demo on a marker machine. 5s against
# a feed arriving every 300s is negligible latency.
LOADER_POLL_SECONDS=5.0

# =============================================================================
# PHASE 2 - Spark and Job A
# =============================================================================

# ----------------------------------------------------------------------------
# Spark cluster sizing. Modest because the whole stack shares one Docker VM;
# a worker sized larger than the VM leaves the job stuck in WAITING forever with
# no obvious error, which is the classic standalone-cluster misconfiguration.
# ----------------------------------------------------------------------------
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g
SPARK_DRIVER_MEMORY=768m
SPARK_EXECUTOR_MEMORY=768m

# ----------------------------------------------------------------------------
# Job A - clean and enrich
# ----------------------------------------------------------------------------
# Watermark for Job A's deduplication, in REAL minutes.
#
# THE SUBTLETY: the watermark applies to event_timestamp, which is on the SIMULATED
# axis running 288x faster than wall clock. A literal "2 minutes" of simulated time
# is 0.42 REAL seconds - less than one 5-second micro-batch - so records at the start
# of every batch would arrive already too late and the dedupe state would silently
# discard them. That is exactly what happened before this was expressed in real
# minutes: 1.18M records on the topic and 0 valid rows emitted.
#
# Stated in real minutes and converted using the compression ratio, which is what
# section 7's "2 minutes" actually means. At 288x this becomes 576 simulated minutes,
# comfortably exceeding one micro-batch span (24 sim min at a 5s trigger) and the 4
# simulated minutes the producer back-dates its injected late events by.
DEDUPE_WATERMARK_REAL_MINUTES=2.0

# How far ahead of simulated now an event_timestamp may be before it is rejected.
# Non-zero because micro-batch timing means a reading can legitimately be stamped
# slightly ahead of when the driver evaluates it.
FUTURE_TIMESTAMP_TOLERANCE_MINUTES=5

# 5s matches the <10s end-to-end latency budget in section 2.4 with room for the
# three sink writes.
TRIGGER_INTERVAL_SECONDS=5

CHECKPOINT_ROOT=/data/checkpoints
# A LOCAL volume path, not s3a://. Hadoop's S3A committer commits by renaming from
# a _temporary directory, which SeaweedFS's S3 gateway does not support, so every
# Parquet batch aborted. See docs/ADR-004-parquet-sink.md. The partitioning and the
# replay story are unchanged; only the filesystem differs.
PARQUET_PATH=/data/curated/readings

# 'latest' for a live run, 'earliest' for replay. This single value is most of what
# distinguishes a reprocessing run from a live one - concrete evidence for the
# single-codebase claim in section 2.2d.
# Records per micro-batch. Sized so the batch's EVENT-TIME span stays inside the
# dedupe watermark: 200 readings per producer tick, 9.6 simulated minutes between
# ticks, so 2000 records spans ~96 simulated minutes against a 576-minute watermark.
# Raising this without raising the watermark makes Job A silently drop clean readings.
MAX_OFFSETS_PER_TRIGGER=2000

STARTING_OFFSETS=latest

# S3 credentials for the Spark s3a connector. Match the object store's root
# credentials; SeaweedFS accepts any credentials by default, but they are named
# explicitly so the configuration is correct if authentication is enabled.
S3_ACCESS_KEY=smartgrid
S3_SECRET_KEY=smartgrid
