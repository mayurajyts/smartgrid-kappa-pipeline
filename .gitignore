# Local environment — .env.example is committed, .env is not
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage

# Runtime data — all regenerable, never committed (reproducible-from-clean-clone rule)
data/
drop/
checkpoints/
*.log

# Docker buildx state, created in-tree when DOCKER_CONFIG points here. Build
# metadata, not source.
.docker/

# Scratch directories used while probing behaviour during development.
probe_tmp/
.probe/

# OS
.DS_Store
Thumbs.db
