            "type": "postgres",
            "uid": "smartgrid-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(running_cost) AS \"priced\"\nFROM household_billing_running\nWHERE sim_date = (SELECT max(sim_date) FROM household_billing_running)",
          "refId": "A",
