          "rawSql": "SELECT household_id AS \"Household\",\n       round(consumption_kwh, 2) AS \"Consumed kWh\",\n       round(solar_kwh, 2)       AS \"Generated kWh\",\n       round(net_grid_kwh, 2)    AS \"Net grid kWh\",\n       running_cost              AS \"Running cost LKR\",\n       tariff_missing            AS \"Awaiting tariff\"\nFROM household_billing_running\nWHERE sim_date = (SELECT max(sim_date) FROM household_billing_running)\nORDER BY net_grid_kwh DESC\nLIMIT 10",
