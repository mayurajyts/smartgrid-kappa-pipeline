{
  "uid": "smartgrid-business",
  "title": "Smart Grid - Business",
  "description": "Business view (plan section 8): zone load and renewable mix (R1, R2), meter coverage, and household billing (R5, R6). All timestamps are on the SIMULATED axis, 288x wall clock.",
  "tags": [
    "smartgrid",
    "business"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "panels": [
    {
      "type": "stat",
      "title": "Grid load (latest window)",
      "description": "Total consumption across all zones in their most recent window (R1).",
      "datasource": {
        "type": "postgres",
        "uid": "smartgrid-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartgrid-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(total_consumption_kwh) AS \"kWh\"\nFROM (SELECT DISTINCT ON (grid_zone) grid_zone, total_consumption_kwh\n      FROM zone_load_1m ORDER BY grid_zone, window_start DESC) latest",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Renewable share",
      "description": "Solar share of load across the grid (R2). Recomputed from summed kWh, NOT averaged across zones -- averaging percentages would weight a small zone equally with a large one. Thresholds mark the LOW_RENEWABLE alert band (<15%) that Job D will act on in Phase 6.",
      "datasource": {
        "type": "postgres",
        "uid": "smartgrid-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d13913",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 15
              },
              {
                "color": "#1f8c4d",
                "value": 35
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartgrid-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN sum(total_consumption_kwh) > 0\n            THEN least(100, greatest(0, sum(total_solar_kwh)\n                 / sum(total_consumption_kwh) * 100)) END AS \"%\"\nFROM (SELECT DISTINCT ON (grid_zone) grid_zone, total_consumption_kwh, total_solar_kwh\n      FROM zone_load_1m ORDER BY grid_zone, window_start DESC) latest",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
          }
        }
      ]
    },
