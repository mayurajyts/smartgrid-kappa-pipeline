    {
      "type": "stat",
      "title": "Bills priced today",
      "description": "Households with a computed running cost for the newest simulated day. Expected to be 0 during a day in progress and ~200 once that day's tariff lands at D+1 (assumption 14) -- a zero here is normal, not a fault.",
      "datasource": {
        "type": "postgres",
        "uid": "smartgrid-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
